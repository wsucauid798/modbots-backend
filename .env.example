HOST=0.0.0.0
PORT=3001

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=modbots
POSTGRES_USER=modbots
POSTGRES_PASSWORD=modbots

REDIS_URL=redis://redis:6379
NATS_URL=nats://nats:4222

S3_ENDPOINT=http://minio:9000
S3_BUCKET=modbots
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

MODERATION_MIN_CONFIDENCE=0.9
MODERATION_ALLOWED_ACTIONS=delete_message,mute_actor,unmute_actor,remove_actor

AUTH_MODE=optional
SESSION_TTL_DAYS=30

# Central CPU-only chat bot inference.
MODEL_ID=google/gemma-4-E4B-it-qat-q4_0-gguf:Q4_0
LLAMA_CONTEXT_SIZE=4096
LLAMA_PARALLEL=1
LLAMA_THREADS=8
LLAMA_THREADS_BATCH=8
LLAMA_IMAGE_MAX_TOKENS=512
INFERENCE_TIMEOUT_SECONDS=600
INFERENCE_API_KEY=change-this-before-deployment
CHAT_TEMPO=1

# Account surface (sign in, register, OIDC hand-off).
ACCOUNT_ISSUER=http://localhost:3003
ACCOUNT_URL=http://account:3003
COOKIE_SECRET=dev-only-cookie-secret-change-me
DESKTOP_REDIRECT_URI=http://127.0.0.1:53682/callback

# Unified Profile-Picture System.
UPPS_PUBLIC_URL=http://localhost:3010
MODBOTS_UPPS_HOST=0.0.0.0
MODBOTS_UPPS_PORT=3010
