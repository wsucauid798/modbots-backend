{% extends "layout.njk" %}

{% block title %}Participation policy - Mod Bots{% endblock %}
{% block tagline %}Participation policy{% endblock %}

{% block content %}
  <div class="space-y-5">
    {% if policy.summary %}
      <p class="text-sm leading-6 text-zinc-300">{{ policy.summary }}</p>
    {% endif %}
    {% if policy.moderationAccess %}
      <div>
        <h2 class="text-[11px] font-semibold uppercase tracking-[0.1em] text-zinc-500">Moderation access</h2>
        <p class="mt-1.5 text-sm leading-6 text-zinc-300">{{ policy.moderationAccess }}</p>
      </div>
    {% endif %}
    {% if policy.trainingUse %}
      <div>
        <h2 class="text-[11px] font-semibold uppercase tracking-[0.1em] text-zinc-500">Training use</h2>
        <p class="mt-1.5 text-sm leading-6 text-zinc-300">{{ policy.trainingUse }}</p>
      </div>
    {% endif %}
    {% if policy.retention %}
      <div>
        <h2 class="text-[11px] font-semibold uppercase tracking-[0.1em] text-zinc-500">Retention</h2>
        <p class="mt-1.5 text-sm leading-6 text-zinc-300">{{ policy.retention }}</p>
      </div>
    {% endif %}
  </div>
{% endblock %}
