{
  "name": "modbots-account",
  "private": true,
  "version": "0.0.1-beta",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc -p tsconfig.json && npm run build:css && npm run copy:views",
    "copy:views": "node -e \"require('node:fs').cpSync('src/views', 'dist/views', { recursive: true })\"",
    "build:css": "tailwindcss -i src/styles/app.css -o public/assets/app.css --minify",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/formbody": "^8.0.2",
    "@fastify/middie": "^9.3.3",
    "@fastify/static": "^8.2.0",
    "@fastify/view": "^11.1.0",
    "fastify": "^5.6.0",
    "ioredis": "^5.6.1",
    "jose": "^6.0.11",
    "nunjucks": "^3.2.4",
    "oidc-provider": "^9.1.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.15",
    "@types/nunjucks": "^3.2.6",
    "@types/oidc-provider": "^9.5.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2"
  }
}
